# Files in /static have a content hash in their name (main.0f468138.js), so they never change.
# Browsers may keep them for a year: repeat visits load instantly. A new build gets new names.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
</IfModule>
