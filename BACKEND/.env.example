# Copy this file to "../.env" (project root) or "BACKEND/.env" and fill in real values.
# Never commit the real .env file.

# Laptop par ye use hoga (NODE_ENV set na ho to development mode)
LOCAL_MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/

# Hostinger par (NODE_ENV=production) ye use hoga
PROD_MONGO_URI=

# Optional: set ho to upar wale dono ko override karta hai
# MONGO_URI=

PORT=5000
